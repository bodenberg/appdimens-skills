        "setup": "AppDimensWpf.Initialize(this) before InitializeComponent()",
        "tokens": "{ad:ASdp …} is not a markup name → C# 24.ASdp() or bounded {ad:FSdp 24}; text {ad:Ssp 14}",
        "must_not": [
          "mixing AppDimens.Sdps.Wpf and AppDimens.Net.Wpf"
        ]
      },
      "assert": {
        "must_match": [
          "AppDimens\\.Net",
          "AppDimensWpf\\.Initialize"
        ],
        "must_not_match": [
          "AppDimens\\.Sdps\\.Wpf"
        ],
        "must_ask": false
      }
    },
