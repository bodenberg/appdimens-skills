        ]
      },
      "input": "const styles = StyleSheet.create({ card: { padding: 16, borderRadius: 12 }, title: { fontSize: 18 } }); used in <Card/>.",
      "expect": {
        "pattern": "createDimenStyles(() => ({ … })) + const styles = useStyles() in the component",
        "tokens": "asdp(16), asdp(12), assp(18) imported from 'appdimens-react-native/auto'",
        "must_not": [
          "StyleSheet.create with sdp() at module scope (never updates)",
          "sdpPx in fontSize"
        ]
      },
      "assert": {
        "must_match": [
          "createDimenStyles",
          "appdimens-react-native/auto",
          "useStyles\\(\\)"
        ],
        "must_not_match": [
          "fontSize:\\s*\\w*Px\\(",
          "asdp\\(16\\)",
          "assp\\(18\\)"
        ],
        "must_ask": false
      }
    },
