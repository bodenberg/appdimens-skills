      "input": "SwiftUI: HStack(spacing: 8) { Image(systemName: \"star\").frame(width: 24, height: 24); Text(title).font(.system(size: 15)) }.padding(.horizontal, 16).frame(minHeight: 44); Divider()",
      "expect": {
