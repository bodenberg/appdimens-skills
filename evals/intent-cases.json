        "icon 24": "18.5.asdp",
        "font 15": ".font(.system(size: 11.5.assp))",
        "padding 16": "12.asdp",
        "minHeight 44": "hit area kept as a fixed platform minimum (contentShape + frame(minWidth/minHeight: 44)); visual not clamped",
        "Divider()": "unchanged — system hairline",
        "imports": [
          "AppDimensDynamic (or AppDimensAuto)"
        ]
      },
      "assert": {
        "must_match": [
          "\\b6\\.asdp",
          "18\\.5\\.asdp",
          "11\\.5\\.assp",
          "\\b12\\.asdp",
          "contentShape",
          "Divider\\(\\)"
        ],
        "must_not_match": [
          "\\b8\\.asdp",
          "\\b24\\.asdp",
          "\\b15\\.assp",
          "44\\.asdp"
        ],
        "must_ask": false
      }
    },
    {
      "id": "xml-integer-normalization",
      "mode": "read",
      "config": {
        "targets": [
          {
            "platform": "android-xml",
            "library": "appdimens-sdps"
          }
        ],
        "formFactors": [
          "phone"
        ],
        "design": {
          "source": "figma",
          "baseScreen": {
            "width": 360,
            "height": 800,
            "unit": "dp",
            "orientation": "portrait",
            "fontScale": 1,
            "confirmed": true
          },
          "normalization": "match-base",
          "rounding": 1
        }
      },
      "input": "List item: padding 16, avatar 40, title 16sp, subtitle 14sp, row min height 72.",
      "expect": {
        "padding": "@dimen/_13sdp (16 ÷ 1.2 = 13.3 → 13)",
        "avatar": "@dimen/_33sdp",
        "title": "@dimen/_13ssp",
        "subtitle": "@dimen/_12ssp",
        "row": "RecyclerView item; minHeight from @dimen/_60sdp",
        "must_not": [
          "@dimen/_13.5sdp (decimals do not exist)",
          "asdp in XML"
        ]
      },
      "assert": {
        "must_match": [
          "@dimen/_13sdp",
          "@dimen/_33sdp",
          "@dimen/_13ssp",
          "@dimen/_12ssp"
        ],
        "must_not_match": [
          "@dimen/_\\d+\\.\\d+",
          "asdp"
        ],
        "must_ask": false
      }
    },
    {
      "id": "web-desktop-frame",
      "mode": "read",
      "config": {
        "targets": [
          {
            "platform": "web",
            "library": "webdimens"
          }
        ],
        "formFactors": [
          "phone",
          "desktop",
          "web"
        ]
      },
      "input": "Two frames: 'Landing — Mobile' 390x2400 and 'Landing — Desktop' 1440x900. Hero title 32 on mobile, 56 on desktop. Content max width 1200 on desktop.",
      "expect": {
        "base": "mobile frame is the base; desktop differences become adapt overrides (@w840/@w1200)",
        "title": "fs:32assp (or fssp) + fs@w1200:<value> — not 56 normalized against 900",
        "max-width": "max-width: 1200px with /* ad:fixed max-content-width */",
        "must_not": [
          "sdp tokens normalized from the 1440x900 frame",
          "Px tokens in classes"
        ]
      },
      "assert": {
        "must_match": [
          "@w(840|1200)",
          "max-width:\\s*1200px"
        ],
        "must_not_match": [
          "\\d+(\\.\\d+)?sdpPx",
          "class=\\\"[^\\\"]*Px"
        ],
        "must_ask": false
      }
    },
    {
      "id": "rn-reactivity",
      "mode": "edit",
      "config": {
        "targets": [
          {
            "platform": "react-native",
            "library": "appdimens-react-native"
          }
        ],
