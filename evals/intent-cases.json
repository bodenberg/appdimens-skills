{
  "$comment": "Golden cases. `expect` explains the decision in prose; `assert` is machine-checkable: every must_match regex must appear in the agent's output, no must_not_match may appear, and must_ask says whether the agent should stop with a question first. Score with: node evals/score.mjs <case-id> <agent-output-file>.",
  "cases": [
    {
      "id": "grid-from-repeated-cards",
      "mode": "read",
      "config": {
        "targets": [
          {
            "platform": "android-compose",
            "library": "appdimens-dynamic"
          }
        ],
        "formFactors": [
          "phone",
          "tablet"
        ],
        "design": {
          "source": "figma",
          "baseScreen": {
            "width": 360,
            "height": 800,
            "unit": "dp",
            "orientation": "portrait",
            "fontScale": 1,
            "id": "android-360x800",
            "confirmed": true
          },
          "normalization": "match-base"
        }
      },
      "input": "Figma frame 'Home' 360x1400, vertical Auto Layout, padding 16, gap 16. Child 'Products': Auto Layout horizontal, wrap on, gap 12, Fill container width; contains 6 instances of component 'Card/Product' (Hug height, Fill width in a 2-up wrap). Each card: padding 12, corner radius 8, image with locked 4:3 ratio, title text 16/24 (2 lines max), price text 14, 1px divider.",
      "expect": {
        "Home": {
          "role": "screen",
          "overflow": "scroll-v"
        },
        "Home/Products": {
          "role": "grid",
          "sizing.width": "fill",
          "scale.spacing": "adaptive"
        },
        "Card/Product": {
          "role": "card",
          "tokens": "padding 10.asdp (12 ÷ 1.2), radius 6.5.asdp"
        },
        "Card/Product/Image": {
          "role": "media",
          "sizing.height": "ratio",
          "code": "aspectRatio(4f / 3f)"
        },
        "Card/Product/Title": {
          "role": "text",
          "overflow": "truncate",
          "tokens": "13.5.assp"
        },
        "Card/Product/Divider": {
          "role": "divider",
          "scale": "fixed",
          "code": "1.dp + ad:fixed"
        },
        "imports": [
          "com.appdimens.dynamic.compose.auto",
          "appdimens-dynamic-auto module"
        ],
        "must_not": [
          "absolute offsets",
          "LazyColumn of rows built by hand",
          "1.asdp divider",
          "invented sw600 breakpoint"
        ]
      },
      "assert": {
        "must_match": [
          "10(\\.0)?\\.asdp",
          "6\\.5\\.asdp|6\\.67\\.asdp",
          "aspectRatio\\(4f? ?/ ?3f?\\)",
          "1\\.dp",
          "compose\\.auto"
        ],
        "must_not_match": [
          "1\\.asdp",
          "\\boffset\\(",
          "absolute"
        ],
        "must_ask": false
      }
    },
    {
      "id": "carousel-ambiguous",
      "mode": "read",
      "config": {
        "targets": [
          {
            "platform": "flutter",
            "library": "appdimens-flutter"
          }
        ],
        "formFactors": [
          "phone"
        ],
        "design": {
          "source": "screenshot",
          "baseScreen": {
            "width": 390,
            "height": 844,
            "unit": "pt",
            "orientation": "portrait",
            "fontScale": 1,
            "id": "iphone-14"
          },
          "normalization": "as-is"
        }
      },
      "input": "Screenshot (1170 px wide) of a row of 5 promo cards; the 4th card is cut at the right edge. No structure data.",
      "expect": {
        "export-scale": "3x (1170 ÷ 390): divide pixels by 3 before anything else",
        "Promos": {
          "role": "carousel",
          "overflow": "scroll-h",
          "confidence": "< 0.8 (screenshot only) → listed under needs review or asked"
        },
        "code": "ListView.builder(scrollDirection: Axis.horizontal) or PageView, spacing in .sdp",
        "must_not": [
          "Row with fixed widths overflowing",
          "pixel values used as logical units"
        ]
      },
      "assert": {
        "must_match": [
          "scrollDirection:\\s*Axis\\.horizontal|PageView",
          "needs review|\\?"
        ],
        "must_not_match": [
          "\\b1170\\b.*sdp"
        ],
        "must_ask": false
      }
    },
    {
