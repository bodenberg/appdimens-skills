{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bodenberg/appdimens-skills/schemas/layout-intent.schema.json",
  "title": "AppDimens layout intent",
  "description": "Platform-neutral intent of one UI node, decided before any unit or library is chosen. See skills/appdimens-layout-intent/references/intent-model.md.",
  "type": "object",
  "required": ["node", "role", "sizing", "scale", "confidence"],
  "additionalProperties": false,
  "$defs": {
    "axisSizing": {
      "oneOf": [
        { "enum": ["hug", "fill", "fixed", "ratio"] },
        {
          "type": "object", "required": ["clamp"], "additionalProperties": false,
          "properties": { "clamp": { "type": "object", "properties": { "min": { "type": "number" }, "max": { "type": "number" } }, "additionalProperties": false } }
        },
        {
          "type": "object", "required": ["fraction"], "additionalProperties": false,
          "properties": { "fraction": { "type": "object", "required": ["of", "percent"], "properties": { "of": { "enum": ["width", "height", "smallest"] }, "percent": { "type": "number", "minimum": 0, "maximum": 100 } }, "additionalProperties": false } }
        }
      ]
    },
    "policy": { "enum": ["scaled", "adaptive", "bounded", "width", "height", "fraction", "fit", "fill", "damped", "physical", "fixed", "platform", "fit-text"] }
  },
  "properties": {
    "node": { "type": "string", "description": "Path or id of the source node (design layer path, file:line, component name)." },
    "role": {
      "enum": ["screen", "section", "stack-v", "stack-h", "overlay", "list", "grid", "carousel", "card", "button", "icon-button", "chip", "toggle", "input", "nav", "text", "media", "icon", "divider", "spacer", "hud", "world"]
    },
    "sizing": {
      "type": "object", "required": ["width", "height"], "additionalProperties": false,
      "properties": { "width": { "$ref": "#/$defs/axisSizing" }, "height": { "$ref": "#/$defs/axisSizing" }, "aspectRatio": { "type": "string", "pattern": "^[0-9.]+:[0-9.]+$" } }
    },
    "overflow": { "enum": ["none", "scroll-v", "scroll-h", "wrap", "truncate", "clip", "fit-text"], "default": "none" },
    "maxLines": { "type": "integer", "minimum": 1 },
    "repetition": {
      "type": "object", "additionalProperties": false,
      "properties": { "itemNode": { "type": "string" }, "minItemWidth": { "type": "number" }, "columns": { "type": "integer", "minimum": 1 } }
    },
    "scale": {
      "type": "object",
      "description": "Policy per property class.",
      "additionalProperties": false,
      "properties": {
        "spacing": { "$ref": "#/$defs/policy" },
        "radius": { "$ref": "#/$defs/policy" },
        "size": { "$ref": "#/$defs/policy" },
        "text": { "$ref": "#/$defs/policy" },
        "icon": { "$ref": "#/$defs/policy" },
        "border": { "$ref": "#/$defs/policy" },
        "elevation": { "$ref": "#/$defs/policy" }
      }
    },
    "adapt": {
      "type": "array",
      "items": {
        "type": "object", "required": ["when", "set"], "additionalProperties": false,
        "properties": {
          "when": { "type": "string", "examples": ["sw600", "w840", "landscape", "tv"] },
          "set": { "type": "object", "description": "Property overrides at this breakpoint, e.g. { \"columns\": 3 } or { \"padding\": 24 }." }
        }
      }
    },
    "tokens": { "type": "object", "description": "Resolved base values per property, e.g. { \"padding\": 16, \"radius\": 12, \"fontSize\": 16 }.", "additionalProperties": { "type": "number" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "source": { "enum": ["annotated", "structural", "inferred", "code", "user"], "default": "inferred" }
  }
}
