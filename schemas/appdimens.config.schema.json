{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bodenberg/appdimens-skills/schemas/appdimens.config.schema.json",
  "title": "AppDimens project contract",
  "description": "Decisions made once per project so AI agents never re-ask or guess them. Lives at the repository root as appdimens.config.json.",
  "type": "object",
  "required": ["targets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "library"],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "enum": ["android-compose", "android-views", "android-xml", "kmp", "apple", "flutter", "react-native", "web", "dotnet-maui", "dotnet-desktop", "dotnet-android", "games"]
          },
          "library": {
            "enum": ["appdimens-dynamic", "appdimens-sdps", "appdimens-ssps", "appdimens-kmp", "appdimens-ios", "appdimens-flutter", "appdimens-react-native", "webdimens", "appdimens-net-sdps", "appdimens-net", "appdimens-net-android", "appdimens-games"]
          },
          "version": { "type": "string", "examples": ["3.2.0", "3.2.1", "3.6.1"] },
          "paths": { "type": "array", "items": { "type": "string" }, "description": "Globs of source paths this target owns." },
          "strategies": {
            "type": "array",
            "items": { "enum": ["scaled", "auto", "percent", "power", "fluid", "interpolated", "logarithmic", "diagonal", "perimeter", "fit", "fill", "density", "resize", "units"] },
            "description": "Strategy modules/packages installed for this target."
          }
        }
      }
    },
    "formFactors": {
      "type": "array",
      "items": { "enum": ["phone", "foldable", "tablet", "desktop", "web", "tv", "car", "watch"] },
      "default": ["phone"]
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "enum": ["scaled", "adaptive", "bounded", "damped"], "description": "Default policy for spacing, radii, icons, control sizes." },
        "text": { "enum": ["scaled", "adaptive", "bounded", "damped"], "description": "Default policy for typography (sp kind)." }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["figma", "claude-design", "sketch", "penpot", "screenshot", "spec", "other"] },
        "frameWidth": { "type": "number", "minimum": 1, "description": "Logical width of the base design frame (dp/pt/CSS px at 1x)." },
        "frameHeight": { "type": "number", "minimum": 1 },
        "normalization": {
          "enum": ["design-at-300", "match-frame", "as-is"],
          "description": "design-at-300: frames are 300 wide; match-frame: base = design / factor(policy, frame); as-is: write design values directly (they grow by the factor)."
        },
        "rounding": { "type": "number", "exclusiveMinimum": 0, "default": 0.5, "description": "Rounding step for match-frame. Use 1 for Android XML (integer resources)." }
      }
    },
    "breakpoints": {
      "type": "array",
      "description": "The only breakpoints agents may use. Expressed as AppDimens qualifiers.",
      "items": {
        "type": "object",
        "required": ["name", "when"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "examples": ["tablet", "expanded"] },
          "when": { "type": "string", "pattern": "^(sw|w|h)[0-9]+$|^(landscape|portrait|tv|car|watch|desk|fold-open|fold-half|flip-open|flip-half)$", "examples": ["sw600", "w840"] }
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Where design tokens live in code, so agents edit the theme instead of call sites.",
      "additionalProperties": { "type": "string" },
      "examples": [{ "spacing": "app/src/main/java/com/acme/ui/theme/Spacing.kt", "typography": "app/src/main/java/com/acme/ui/theme/Type.kt" }]
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixedThreshold": { "type": "number", "default": 2, "description": "Literals at or below this value are treated as hairlines and not flagged." },
        "ignore": { "type": "array", "items": { "type": "string" }, "description": "Path substrings to skip." },
        "warningsAsErrors": { "type": "boolean", "default": false }
      }
    }
  }
}
