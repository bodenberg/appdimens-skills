{
  "description": "Validate AppDimens usage after every file edit (silent outside AppDimens projects).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/tools/appdimens-kit/hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
